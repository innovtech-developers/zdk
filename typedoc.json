{
  "$schema": "https://typedoc.org/schema.json",
  "name": "ZDK",
  "entryPoints": [
    "./src/index.ts"
  ],
  "out": "docs/api",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "intentionallyNotExported": [
    "Content",
    "Operation",
    "VerbsOf",
    "DefaultContentType",
    "paths",
    "RequiredBy",
    "OptionalBy",
    "BinaryField",
    "RawConnection",
    "RawContactPostData",
    "RawContactTagsPostData",
    "RawMessage",
    "RawMessageTemplate",
    "RawSendMediaMessage",
    "RawSendTemplate",
    "RawTicketResolveForm",
    "RawUploadTemp",
    "RawUploadTempResponse",
    "RawWebhookPostData",
    "Connections",
    "Contacts",
    "Dashboard",
    "Messages",
    "Metrics",
    "Queues",
    "Storage",
    "Tags",
    "Templates",
    "Tickets",
    "Users",
    "Webhooks"
  ]
}
